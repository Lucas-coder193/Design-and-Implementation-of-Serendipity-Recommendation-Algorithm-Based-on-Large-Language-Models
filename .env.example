# Copy the values into your shell environment. Scripts do not auto-load .env.
OPENROUTER_API_KEY=
# Optional proxy. Leave unset when not needed.
OPENROUTER_PROXY=
# Local inference settings (not required by the lightweight demo).
BASE_MODEL_PATH=Qwen/Qwen2.5-7B-Instruct
ANALYST_ADAPTER=/path/to/analyst_adapter
EXPLORER_ADAPTER=/path/to/explorer_adapter
